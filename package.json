{
  "name": "toks-uniform-inventory",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-vendor.js && node scripts/copy-npmrc.js",
    "setup": "node scripts/setup-local.js",
    "update": "node scripts/update-from-github.js",
    "install:all": "node scripts/ensure-vendor.js && node scripts/copy-npmrc.js && npm install && cd server && npm install && cd ../client && npm install && cd ../kitchen && npm install && cd ../finance && npm install && npm run install:all && cd ../sacco && npm install && npm run install:all",
    "db:setup": "cd server && npm run db:setup",
    "db:setup:finance": "cd finance && npm run db:setup",
    "db:setup:sacco": "cd sacco && npm run db:setup",
    "db:update-catalog": "cd server && npm run db:update-catalog",
    "db:report-catalog": "cd server && npm run db:report-catalog",
    "db:sync-stock-from-sizes": "cd server && npm run db:sync-stock-from-sizes",
    "db:remove-unused-catalog": "cd server && npm run db:remove-unused-catalog --",
    "db:remove-keep-products": "cd server && npm run db:remove-keep-products --",
    "db:backup-uniform": "cd server && npm run db:backup-uniform --",
    "db:restore-uniform": "cd server && npm run db:restore-uniform --",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:kitchen\" \"npm run dev:client\" \"npm run dev:finance\" \"npm run dev:sacco\"",
    "dev:server": "cd server && npm run dev",
    "dev:kitchen": "cd kitchen && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:finance": "cd finance && npm run dev",
    "dev:sacco": "cd sacco && npm run dev",
    "dev:gateway": "node render-server.js",
    "build": "cd client && npm run build",
    "build:production": "npm run install:all && npm run build",
    "start": "node start-unified.js",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "render:start": "node start-unified.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "utils-merge": "file:vendor/utils-merge"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "utils-merge": "$utils-merge"
  }
}
