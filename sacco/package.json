{
  "name": "toks-sacco",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node ../scripts/ensure-vendor.js",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "db:setup": "npm run db:setup --prefix server",
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
